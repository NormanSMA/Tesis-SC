# Proxy HTTPS de TRACORE (ADR-017). Solo escucha en 127.0.0.1 (ver compose.yaml, perfil "proxy").
# TLS 1.2 y 1.3 con certificado interno de Caddy. HTTP en 8080 redirige a HTTPS en 8443.
{
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	skip_install_trust
}

tracore.localhost:8443 {
	tls internal {
		protocols tls1.2 tls1.3
	}
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:3000 {
		# La app confía en X-Forwarded-For solo si esta clave coincide con PROXY_CLAVE.
		header_up X-Proxy-Clave {env.PROXY_CLAVE}
	}
}

http://tracore.localhost:8080 {
	redir https://tracore.localhost:8443{uri} 308
}

# Valores de ejemplo para desarrollo local. No sirven para produccion.
# Copia este archivo a .env para sobreescribir valores. compose.yaml lee ambos.
POSTGRES_USER=sc_owner
POSTGRES_PASSWORD=cambiar-en-produccion
POSTGRES_DB=sc_plataforma
DB_PORT=5442
APP_PORT=3000
# Rol de la aplicacion. Sin superusuario y sin ser dueno de las tablas (ADR-009).
APP_DB_USER=sc_app
APP_DB_PASSWORD=cambiar-en-produccion
# Estas URL son para usar desde la maquina anfitriona (pnpm dev, pruebas, prisma).
# Dentro de Docker, scripts/docker/entrypoint.sh las arma con DB_HOST=db.
DATABASE_URL="postgresql://sc_app:cambiar-en-produccion@127.0.0.1:5442/sc_plataforma?schema=public"
DATABASE_URL_MIGRACION="postgresql://sc_owner:cambiar-en-produccion@127.0.0.1:5442/sc_plataforma?schema=public"
TEST_DATABASE_URL="postgresql://sc_owner:cambiar-en-produccion@127.0.0.1:5443/sc_test?schema=public"
SESSION_COOKIE_NAME=sc_sesion
SESSION_TTL_HOURS=12

# Claves de usuarios de la siembra. Las define el agente de datos.
# SEED_PASSWORD_*
